generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  TOURIST
  GUIDE
  ADMIN
}

enum VerificationStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
}

enum ExperienceCategory {
  FOOD
  HERITAGE
  SHOPPING
  CULTURE
  SIGHTSEEING
  NATURE
  OTHER
}

enum BookingStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  COMPLETED
}

enum SuggestionStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String?
  googleId     String?  @unique
  authProvider String   @default("LOCAL")
  role         Role     @default(TOURIST)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  guideProfile         GuideProfile?
  reviewsGiven         GuideVerification[] @relation("AdminReviews")
  touristBookings      Booking[]           @relation("TouristBookings")
  reviewsWritten       Review[]            @relation("ReviewsByTourist")
  itinerarySuggestions ItinerarySuggestion[]
  messagesSent         Message[]
}

model GuideProfile {
  id                 Int                @id @default(autoincrement())
  userId             Int                @unique
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  bio                String             @db.Text
  city               String
  country            String             @default("India")
  languages          Json
  expertise          Json
  yearsOfExperience  Int                @default(0)
  hourlyRate         Int?
  serviceAreas       Json
  avatarUrl          String?

  verificationStatus VerificationStatus @default(NOT_SUBMITTED)
  avgRating          Float              @default(0)
  reviewCount        Int                @default(0)

  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  verification       GuideVerification?
  experiences        Experience[]
  bookings           Booking[]
  reviews            Review[]

  @@index([city])
  @@index([verificationStatus])
}

model GuideVerification {
  id              Int                @id @default(autoincrement())
  guideProfileId  Int                @unique
  guideProfile    GuideProfile       @relation(fields: [guideProfileId], references: [id], onDelete: Cascade)

  govIdUrl        String
  credentialsUrl  String?
  notes           String?            @db.Text
  status          VerificationStatus @default(PENDING)
  rejectionReason String?            @db.Text

  submittedAt     DateTime           @default(now())
  reviewedAt      DateTime?
  reviewedBy      Int?
  reviewer        User?              @relation("AdminReviews", fields: [reviewedBy], references: [id])

  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([status])
}

model Experience {
  id                Int                @id @default(autoincrement())
  guideProfileId    Int
  guideProfile      GuideProfile       @relation(fields: [guideProfileId], references: [id], onDelete: Cascade)

  title             String
  category          ExperienceCategory
  city              String
  description       String             @db.Text
  durationMinutes   Int
  price             Int
  maxGroupSize      Int
  languages         Json
  images            Json
  isActive          Boolean            @default(true)

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  bookings          Booking[]

  @@index([city])
  @@index([category])
  @@index([isActive])
}

model Booking {
  id               Int           @id @default(autoincrement())
  touristId        Int
  guideProfileId   Int
  experienceId     Int
  status           BookingStatus @default(PENDING)

  scheduledDate    DateTime
  startTime        String
  durationMinutes  Int
  groupSize        Int
  agreedPrice      Int
  message          String?       @db.Text

  tourist          User          @relation("TouristBookings", fields: [touristId], references: [id])
  guideProfile     GuideProfile  @relation(fields: [guideProfileId], references: [id], onDelete: Cascade)
  experience       Experience    @relation(fields: [experienceId], references: [id])

  review           Review?
  itinerary        Itinerary?
  conversation     Conversation?

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([touristId])
  @@index([guideProfileId])
  @@index([status])
}

model Review {
  id              Int          @id @default(autoincrement())
  bookingId       Int          @unique
  booking         Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  touristId       Int
  tourist         User         @relation("ReviewsByTourist", fields: [touristId], references: [id])
  guideProfileId  Int
  guideProfile    GuideProfile @relation(fields: [guideProfileId], references: [id], onDelete: Cascade)

  rating          Int
  comment         String?      @db.Text

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([guideProfileId])
}

model Itinerary {
  id          Int             @id @default(autoincrement())
  bookingId   Int             @unique
  booking     Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  title       String?
  notes       String?         @db.Text

  items       ItineraryItem[]
  suggestions ItinerarySuggestion[]

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model ItineraryItem {
  id           Int       @id @default(autoincrement())
  itineraryId  Int
  itinerary    Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)

  order        Int
  title        String
  description  String?   @db.Text
  startTime    String?
  endTime      String?
  locationName String?
  latitude     Float?
  longitude    Float?
  notes        String?   @db.Text

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([itineraryId])
}

model ItinerarySuggestion {
  id            Int              @id @default(autoincrement())
  itineraryId   Int
  itinerary     Itinerary        @relation(fields: [itineraryId], references: [id], onDelete: Cascade)

  touristId     Int
  tourist       User             @relation(fields: [touristId], references: [id])

  title         String
  description   String?          @db.Text
  locationName  String?

  status        SuggestionStatus @default(PENDING)
  guideResponse String?          @db.Text

  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([itineraryId])
}

model Conversation {
  id        Int       @id @default(autoincrement())
  bookingId Int       @unique
  booking   Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  messages  Message[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Message {
  id             Int          @id @default(autoincrement())
  conversationId Int
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId       Int
  sender         User         @relation(fields: [senderId], references: [id])
  content        String       @db.Text
  readAt         DateTime?

  createdAt      DateTime     @default(now())

  @@index([conversationId])
}